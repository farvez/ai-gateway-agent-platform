OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Reliability (optional, these are the defaults)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5

# Default model per provider (optional; providers retire models, override here)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5
# GROQ_MODEL=openai/gpt-oss-120b

# Database for request logs (optional; default is a local SQLite file)
# DATABASE_URL=sqlite:///./gateway.db

# Admin key for /admin/* and /usage (required to manage teams). Make it long and random, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Guardrails (optional, these are the defaults)
# LLM_MAX_OUTPUT_TOKENS=1024
# MAX_INPUT_CHARS=20000
